server {
    listen 80;
    listen [::]:80;
    server_name __HOST__;
    location /.well-known/acme-challenge/ {
        root /var/www/baxter-acme;
    }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __HOST__;
    ssl_certificate /etc/baxter-response/letsencrypt/live/__HOST__/fullchain.pem;
    ssl_certificate_key /etc/baxter-response/letsencrypt/live/__HOST__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 8m;
    # /api/ already bypasses the navigation fallback in older installed PWAs.
    location = /api/downloads/baxter-response.apk {
        alias /opt/baxter-response/artifacts/baxter-response.apk;
        default_type application/vnd.android.package-archive;
        add_header Content-Disposition 'attachment; filename="baxter-response.apk"';
        add_header Cache-Control "no-store";
    }
    location = /downloads/baxter-response.apk {
        alias /opt/baxter-response/artifacts/baxter-response.apk;
        default_type application/vnd.android.package-archive;
        add_header Content-Disposition 'attachment; filename="baxter-response.apk"';
        add_header Cache-Control "no-store";
    }
    location / {
        proxy_pass http://127.0.0.1:5188;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 360s;
    }
}

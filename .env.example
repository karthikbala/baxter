# pnpm setup generates a private .env.local for native local PostgreSQL.
# Copy this template to .env.production for Ubuntu. Never commit filled values.
NODE_ENV=production
APP_HOST=response.your-domain.com
APP_URL=https://response.your-domain.com
HOST=0.0.0.0
PORT=3001
DEMO_ACCESS=false
AUTH_SECRET=
DEMO_PASSWORD=
# Direct or session-mode DB connections. Do not use a transaction pooler for pg-boss.
DATABASE_ADMIN_URL=
DATABASE_URL=
AUTH_DATABASE_URL=
QUEUE_DATABASE_URL=
RUNTIME_DB_PASSWORD=
AUTH_DB_PASSWORD=
QUEUE_DB_PASSWORD=
# Only for compose.postgres.yml
POSTGRES_PASSWORD=
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.4
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:operations@your-domain.com
# Optional FCM service-account JSON mounted read-only. Never put it in web assets.
FCM_CREDENTIALS_PATH=
FILE_ROOT=/data/files
WORKER_TENANT_IDS=10000000-0000-4000-8000-000000000001

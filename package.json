{
  "name": "baxter-response",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/karthikbala/baxter.git"
  },
  "packageManager": "pnpm@11.25.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,worker,web \"tsx watch apps/api/server.ts\" \"tsx watch apps/worker/index.ts\" \"vite --config apps/web/vite.config.ts\"",
    "dev:api": "tsx watch apps/api/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "db:start": "node scripts/local-postgres.mjs start",
    "db:stop": "node scripts/local-postgres.mjs stop",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "setup": "node scripts/setup.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts && tsup apps/api/server.ts apps/worker/index.ts scripts/migrate.ts scripts/seed.ts --format esm --platform node --out-dir dist/server --target node24 --external pg-native",
    "start": "node dist/server/apps/api/server.js",
    "worker": "node dist/server/apps/worker/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/push-notifications": "8.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.33",
    "@xyflow/react": "12.11.6",
    "better-auth": "1.7.3",
    "decimal.js": "10.6.0",
    "dotenv": "17.4.2",
    "echarts": "6.1.0",
    "exceljs": "4.4.0",
    "fastify": "5.12.3",
    "firebase-admin": "14.3.0",
    "lucide-react": "1.42.0",
    "openai": "7.10.0",
    "pg": "8.23.0",
    "pg-boss": "12.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "web-push": "3.6.7",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.5.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "jsdom": "^30.0.1",
    "prettier": "3.6.2",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  }
}
